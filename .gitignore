.ruff_cache/
.pytype/

# Jupyter notebooks
.ipynb_checkpoints/

# Local environment and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# macOS
.DS_Store

# JetBrains IDE settings
.idea/

# Project-specific files
xkcd_comic_date/*.txt
